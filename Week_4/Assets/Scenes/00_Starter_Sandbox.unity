  m_Script: {fileID: 11500000, guid: a2305fc5e1f1e4c78b7a4dbcfd5c27e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhysicsDemo.DemoHUD
  title: "Starter \xB7 Sandbox"
  concept: 'A blank playground for live demos, with one station per topic: Rigidbody,
    Colliders, Collision detection, Joints, Cloth and Particles. The objects have
    no physics components yet: select one in the Hierarchy, click Add Component in
    the Inspector and press Play to see what it does.'
  controls: "Camera focus dropdown: jump to a station \xB7 Space: put the fast balls
    back and fire again \xB7 Right-drag: orbit \xB7 Scroll: zoom \xB7 WASD/QE: move
    camera \xB7 T: slow-mo \xB7 G: gizmos \xB7 Tab: panel \xB7 R: reset the focused
    station \xB7 Shift+R: reset the whole scene (camera stays)"
  tryInInspector: 
  showNavigation: 1
  resetLabel: Reset scene (Shift+R)
